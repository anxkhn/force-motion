{
  "manifest_version": 3,
  "name": "Force Motion",
  "short_name": "Force Motion",
  "version": "1.0.0",
  "description": "Tiny toggle that makes websites ignore OS Reduce Motion and play animations.",
  "author": "Anas Khan",
  "homepage_url": "https://github.com/anxkhn/force-motion",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Force motion: on",
    "default_icon": {
      "16": "icons/on16.png",
      "32": "icons/on32.png",
      "48": "icons/on48.png",
      "128": "icons/on128.png"
    }
  },
  "icons": {
    "16": "icons/on16.png",
    "32": "icons/on32.png",
    "48": "icons/on48.png",
    "128": "icons/on128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "force-motion@anxkhn.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
